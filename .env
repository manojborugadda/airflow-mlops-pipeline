# Airflow UID (User ID for container - leave empty on Windows)
AIRFLOW_UID=50000

# Fernet Key for Airflow (used for encrypting sensitive data)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=TLNrczBQdFZZUzBkdmQydzNSVEkxTm1GVFMybFhVbnBLUVcxdFFraEJjMjFWYWpJMg==

# Airflow Web UI credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# JWT Secret for Airflow API
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret

# JWT Issuer for Airflow API
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Environment file path
ENV_FILE_PATH=.env

# Additional PIP requirements (if needed)
_PIP_ADDITIONAL_REQUIREMENTS=
